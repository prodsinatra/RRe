GEMINI_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ENABLE_BILLING=false
ENABLE_MOCK_BILLING=false
WEBHOOK_ALLOWED_HOSTS=

# Local development only. Accepts `user_<role>_*` bearer tokens without any
# verification, so the role-picker login in the browser keeps working until
# Firebase Auth is wired into the client. Ignored when NODE_ENV=production.
# Never set this where the server is reachable by anyone else.
ALLOW_MOCK_AUTH=false
